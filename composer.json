{
  "name": "magento-hackathon/reusable-product-images",
  "version": "1.0.0",
  "description": "Reuse existing product gallery images on other products without duplicating the image files.",
  "type": "magento2-module",
  "require": {
    "php": ">=8.1",
    "magento/framework": "*",
    "magento/module-backend": "*",
    "magento/module-catalog": "*",
    "magento/module-product-video": "*",
    "magento/module-store": "*",
    "magento/module-ui": "*"
  },
  "license": [
    "Proprietary"
  ],
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "MagentoHackathon\\ReusableProductImages\\": ""
    }
  },
  "require-dev": {
    "magento/magento-coding-standard": "^41",
    "phpstan/phpstan": "^2.1",
    "bitexpert/phpstan-magento": "^0.44",
    "phpstan/extension-installer": "^1.4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
